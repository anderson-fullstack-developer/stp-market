# Copy to .env and fill in. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Clerk (customer accounts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Auth.js (admin and vendor accounts) — generate with: npx auth secret
AUTH_SECRET=

# Public URL of the site (links in emails, Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (test keys sk_test_... while developing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (product images)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Brevo (transactional emails)
BREVO_API_KEY=
EMAIL_FROM=

# Marketplace
COMMISSION_RATE=10
ADMIN_EMAIL=
# Used only by the seed script to create the first admin
ADMIN_PASSWORD=
